{
  "name": "steamsdk-tool",
  "version": "0.1.20",
  "private": true,
  "description": "SteamSDK 上传工作台 — App 列表 / 内容体检 / 一键检查 / Preview 与正式上传 / 实时日志 / 分支管理",
  "author": "YingYu",
  "repository": {
    "type": "git",
    "url": "https://github.com/yingyu4451/SteamSDK-Tool.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "build:unpacked": "electron-vite build && electron-builder --dir --publish never",
    "watch:unpacked": "node scripts/watch-unpacked.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
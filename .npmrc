# pnpm 配置
# node-linker=hoisted：electron-builder 对 pnpm 的符号链接 node_modules 支持不好，
# 扁平化安装可以避免一类打包失败。
node-linker=hoisted
shamefully-hoist=true

# 国内镜像：electron 二进制走 GitHub Releases 很慢，npmmirror 实测 115ms。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
